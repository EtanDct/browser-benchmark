{
  "name": "browser-benchmark",
  "version": "0.1.0",
  "description": "Benchmark comparant plusieurs navigateurs/frameworks headless sur le contournement anti-bot, la performance et la fidelite de rendu",
  "private": true,
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench": "tsx src/cli.ts",
    "dashboard": "tsx dashboard/generate-dashboard.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pidusage": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
