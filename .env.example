# Copy to .env (git-ignored). Loaded by every npm run command of this project.

# Where Playwright browsers are installed and looked up (npm run install-browsers).
# Needed on Windows when commands run inside a packaged app (e.g. the Claude desktop app):
# AppData is redirected there and Firefox then fails with "spawn UNKNOWN". Any folder outside AppData works.
# PLAYWRIGHT_BROWSERS_PATH=C:\Users\me\.cache\ms-playwright

# Lightpanda (see README): instance to connect to instead of launching one...
# LIGHTPANDA_WS_ENDPOINT=ws://127.0.0.1:9222
# ...or a binary: native (Linux/macOS) or inside WSL (Windows).
# LIGHTPANDA_BIN=/usr/local/bin/lightpanda
# LIGHTPANDA_WSL_BIN=/home/me/.local/bin/lightpanda
# LIGHTPANDA_WSL_DISTRO=Ubuntu

# Camoufox binary (npx camoufox-js fetch). Same AppData caveat as above on Windows.
# CAMOUFOX_INSTALL_DIR=C:\Users\me\.cache\camoufox
